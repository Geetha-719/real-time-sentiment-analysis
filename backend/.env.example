# ============================================================
#  Real-Time Sentiment Analysis System - environment template
#  Copy to backend/.env and fill in real values. NEVER commit .env
# ============================================================

# ---- Database (PostgreSQL) ----
# SQLAlchemy URL. Psycopg 3 driver is "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://sentiment:sentiment@localhost:5432/sentiment_db

# Used only by helper scripts that need to create the database/role
POSTGRES_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
POSTGRES_DB=sentiment_db
POSTGRES_USER=sentiment
POSTGRES_PASSWORD=sentiment

# ---- JWT ----
# Generate a strong secret:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- Application ----
APP_NAME=Real-Time Sentiment Analysis System
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:5173

# ---- Password reset ----
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---- Email / SMTP (optional) ----
# If left blank, password-reset links are logged to the backend console
# and returned in the API response in development mode only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@sentiment.local

# ---- Live data sources (all optional) ----
# NewsAPI - https://newsapi.org  (free developer key)
NEWS_API_KEY=
# GNews - https://gnews.io
GNEWS_API_KEY=
# Reddit script app - https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentiment-dashboard/1.0
# RSS/Atom feeds work without any key.

# ---- ML artifacts ----
MODEL_DIR=ml/models
