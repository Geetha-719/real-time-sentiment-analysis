# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---- Environment / secrets ----
.env
backend/.env
*.env
!.env.example

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
